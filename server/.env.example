# Ghost Relay Server — Local Environment Variables
# Provide this file to new developers so they know what keys are needed.

# ── Redis Ephemeral Store ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Supabase Key Registry ───────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── HTTP/WS Port ────────────────────────────────────────────────────────────
PORT=8080
